FROM mysql/mysql-server:5.7                  //THIS IS MY SQL IMAGE FROM HUB.DOCKER.COM
EXPOSE 3306                                  //IT IS MUSQL PORT NUMBER
COPY init.sql /docker-entrypoint-initdb.d    //THAT INIT.SQL FILE WILL GIVE BY DEVELOPERS AND /docker-entrypoint-initdb.d IS THE DEFAULT PATH FOR MYSQL
ENV MYSQL_ROOR_PASSWORD=admin@123            //USUALLY MYSQL WILL ASK USERNAME AND PASSWORD TO RUN THE FILE SO DEFAULT USER IS ROOT AAND WE HAVE SET THE PASSWORD FOR THAT WE GAVE THE OWN PASSWORD USING ENVIRONMENT VARIABLES (ENV).


BUILD IMAGE: docker build -t dbimage:v1 .
CONTAINER: docker run -d --name db-cont -p 3306 dbimage:v1 //FOR DATABASE WHEN CREATING THE CONTAINER DONT GIVE "-it" IN THE COMMAND AS WE THAT -IT MEANS INTERACTIVE TERMINAL.



NOW GO INSIDE OF THE CONTAINER
COMMAND: docker exec -it db-con bash

AFTER GETTING INSIDE OF THE CONTAINER WE CAN SEE THE DATABASE AND QUIRIES FOR THAT GIVE THIS LOGIN COMMAND
COMMAND: mysql -u root -p (press enter after this command so that we can enter our password to login into database)

AFTER LOGIN WE WILL GO TO MYSQL DATABASE THERE WE CAN PERFORM OUR DATABE COMMANDS
